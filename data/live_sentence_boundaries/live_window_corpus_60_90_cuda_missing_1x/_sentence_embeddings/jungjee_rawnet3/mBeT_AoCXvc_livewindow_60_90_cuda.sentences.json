{
  "provider": "jungjee_rawnet3",
  "video": "mBeT_AoCXvc",
  "folder": "mBeT_AoCXvc_livewindow_60_90_cuda",
  "sentence_file": "D:\\Projekte\\SpeakerDiarization\\data\\live_sentence_boundaries\\live_window_corpus_60_90_cuda_missing_1x\\mBeT_AoCXvc_livewindow_60_90_cuda\\sentences.jsonl",
  "sample_rate": 16000,
  "embedding_shape": [
    149,
