    "end_sec": 28.9,
    "start_time": "00:19.630",
    "end_time": "00:28.900",
    "duration_sec": 9.27,
    "text": "That's right, Margaret Jo. Holiday time is when the most wonderful culinary wishes can come true. Now, what's on your list this holiday season, Margaret Jo?",
    "word_start_index": 40,
    "word_end_index": 65
