    "end_sec": 37.8,
    "start_time": "00:30.500",
    "end_time": "00:37.800",
    "duration_sec": 7.3,
    "text": "Buddhist teachings forbid them to cook, so it's up to the local Thai community to offer the one meal the monks are allowed to eat at 11:00 each day.",
    "word_start_index": 80,
    "word_end_index": 108
  },
  {
    "segment_id": "seg_0003",
