    "end_sec": 28.54,
    "start_time": "00:21.110",
    "end_time": "00:28.540",
    "duration_sec": 7.43,
    "text": "This small and revered group of Buddhist monks live in the monastery attached to the temple. They spend most of their waking hours meditating and studying.",
    "word_start_index": 54,
    "word_end_index": 79
  },
  {
    "segment_id": "seg_0002",
