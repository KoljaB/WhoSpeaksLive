  "segments": [
    {
      "index": 0,
      "segment_id": "seg_0000",
      "speaker_id": "SPEAKER_1",
      "start_sec": 0.68,
      "end_sec": 16.48,
      "duration_sec": 15.8,
      "audio_start_sec": 0.68,
      "audio_end_sec": 16.48,
      "text": "Hi, guys. Welcome to your first day as interns at Mattel, the Barbie division. You're all here because of your interest in toy marketing or in Barbie herself. We take the Barbie brand very seriously here. I'll let the senior VP of Barbie social media elaborate more on that."
    },
    {
      "index": 1,
      "segment_id": "seg_0001",
      "speaker_id": "SPEAKER_2",
      "start_sec": 17.48,
      "end_sec": 31.94,
      "duration_sec": 14.46,
      "audio_start_sec": 17.48,
      "audio_end_sec": 31.94,
      "text": "Who is Barbie? Barbie is fun. Barbie works hard and plays thoughtfully. She has one boyfriend. She is impossible. She is girl to the max. Barbie is current. You understand?"
    },
    {
      "index": 2,
      "segment_id": "seg_0002",
      "speaker_id": "SPEAKER_1",
      "start_sec": 32.259,
      "end_sec": 41.26,
      "duration_sec": 9.001,
      "audio_start_sec": 32.259,
      "audio_end_sec": 41.26,
      "text": "Yes, exactly. And last year we launched her very popular Instagram account, which allows her to connect with her fans online. Now, you three will be helping out with the captions."
    },
    {
      "index": 3,
      "segment_id": "seg_0003",
      "speaker_id": "SPEAKER_2",
      "start_sec": 41.76,
      "end_sec": 42.74,
      "duration_sec": 0.98,
      "audio_start_sec": 41.76,
      "audio_end_sec": 42.74,
      "text": "Why don't we give it a try?"
    },
    {
      "index": 4,
      "segment_id": "seg_0004",
      "speaker_id": "SPEAKER_1",
      "start_sec": 44.34,
      "end_sec": 47.2,
      "duration_sec": 2.86,
      "audio_start_sec": 44.34,
      "audio_end_sec": 47.2,
      "text": "What would be a fun caption for this post? Tamra?"
    },
    {
      "index": 5,
      "segment_id": "seg_0005",
      "speaker_id": "SPEAKER_3",
      "start_sec": 48.16,
      "end_sec": 51.24,
      "duration_sec": 3.08,
      "audio_start_sec": 48.16,
      "audio_end_sec": 51.24,
      "text": "Mm, love my juice and my chocolate bar."
    },
    {
      "index": 6,
      "segment_id": "seg_0006",
      "speaker_id": "SPEAKER_2",
      "start_sec": 52.52,
      "end_sec": 55.0,
      "duration_sec": 2.48,
      "audio_start_sec": 52.52,
      "audio_end_sec": 55.0,
      "text": "That's not a chocolate bar. It's a clutch."
    },
    {
      "index": 7,
      "segment_id": "seg_0007",
      "speaker_id": "SPEAKER_1",
      "start_sec": 55.04,
      "end_sec": 57.62,
      "duration_sec": 2.58,
      "audio_start_sec": 55.04,
      "audio_end_sec": 57.62,
      "text": "It's, it's fine. You, what would you write here?"
    },
    {
      "index": 8,
      "segment_id": "seg_0008",
      "speaker_id": "SPEAKER_4",
      "start_sec": 58.78,
      "end_sec": 59.9,
      "duration_sec": 1.12,
      "audio_start_sec": 58.78,
      "audio_end_sec": 59.9,
      "text": "I'm holding a chocolate bar."
    },
    {
      "index": 9,
      "segment_id": "seg_0009",
      "speaker_id": "SPEAKER_2",
      "start_sec": 60.94,
      "end_sec": 61.84,
      "duration_sec": 0.9,
      "audio_start_sec": 60.94,
      "audio_end_sec": 61.84,
      "text": "I swear to God."
    },
    {
      "index": 10,
      "segment_id": "seg_0010",
      "speaker_id": "SPEAKER_1",
      "start_sec": 61.92,
      "end_sec": 63.9,
      "duration_sec": 1.98,
      "audio_start_sec": 61.92,
      "audio_end_sec": 63.9,
      "text": "Michael, sweetie, he just told you it's a clutch."
    },
    {
      "index": 11,
      "segment_id": "seg_0011",
      "speaker_id": "SPEAKER_4",
      "start_sec": 64.519,
      "end_sec": 67.04,
      "duration_sec": 2.521,
      "audio_start_sec": 64.519,
      "audio_end_sec": 67.04,
      "text": "Oh, oh, then, \"Oh, no, I forgot my clutch.\""
    },
    {
      "index": 12,
      "segment_id": "seg_0012",
      "speaker_id": "SPEAKER_2",
      "start_sec": 68.46,
      "end_sec": 69.58,
      "duration_sec": 1.12,
      "audio_start_sec": 68.46,
      "audio_end_sec": 69.58,
      "text": "She's holding the clutch."
    },
    {
      "index": 13,
      "segment_id": "seg_0013",
      "speaker_id": "SPEAKER_4",
      "start_sec": 70.42,
      "end_sec": 72.38,
      "duration_sec": 1.96,
      "audio_start_sec": 70.42,
      "audio_end_sec": 72.38,
      "text": "Oh, then where's her chocolate bar?"
    },
    {
      "index": 14,
      "segment_id": "seg_0014",
      "speaker_id": "SPEAKER_2",
      "start_sec": 73.32,
      "end_sec": 74.2,
      "duration_sec": 0.88,
      "audio_start_sec": 73.32,
      "audio_end_sec": 74.2,
      "text": "There never was one."
    },
    {
      "index": 15,
      "segment_id": "seg_0015",
      "speaker_id": "SPEAKER_1",
      "start_sec": 74.23,
      "end_sec": 75.64,
      "duration_sec": 1.41,
      "audio_start_sec": 74.23,
      "audio_end_sec": 75.64,
      "text": "All right, never mind. What about you?"
    },
    {
      "index": 16,
      "segment_id": "seg_0016",
      "speaker_id": "SPEAKER_5",
      "start_sec": 77.02,
      "end_sec": 79.82,
      "duration_sec": 2.8,
      "audio_start_sec": 77.02,
      "audio_end_sec": 79.82,
      "text": "I can't shake the image of that girl getting hit by that car-"
    },
    {
      "index": 17,
      "segment_id": "seg_0017",
      "speaker_id": "SPEAKER_5",
      "start_sec": 81.55,
      "end_sec": 87.04,
      "duration_sec": 5.49,
      "audio_start_sec": 81.55,
      "audio_end_sec": 87.04,
      "text": "... four years ago outside of my Dreamhouse. Anyway, I was holding a chocolate bar like this one."
    },
    {
      "index": 18,
      "segment_id": "seg_0018",
      "speaker_id": "SPEAKER_2",
      "start_sec": 89.7,
      "end_sec": 96.35,
      "duration_sec": 6.65,
      "audio_start_sec": 89.7,
      "audio_end_sec": 96.35,
      "text": "Listen to me, boy. Barbie never witnessed such a thing. That sort of thing does not happen outside of Barbie's house."
    },
    {
      "index": 19,
      "segment_id": "seg_0019",
      "speaker_id": "SPEAKER_1",
      "start_sec": 96.38,
      "end_sec": 101.6,
      "duration_sec": 5.22,
      "audio_start_sec": 96.38,
      "audio_end_sec": 101.6,
      "text": "Bernard, calm down. It's okay. Let's just, we'll do another picture, all right? Tamra, what's your caption?"
    },
    {
      "index": 20,
      "segment_id": "seg_0020",
      "speaker_id": "SPEAKER_3",
      "start_sec": 102.32,
      "end_sec": 105.78,
      "duration_sec": 3.46,
      "audio_start_sec": 102.32,
      "audio_end_sec": 105.78,
      "text": "Hi, it's Barbie. I can't find my dog."
    },
    {
      "index": 21,
      "segment_id": "seg_0021",
      "speaker_id": "SPEAKER_2",
      "start_sec": 110.78,
      "end_sec": 114.1,
      "duration_sec": 3.32,
      "audio_start_sec": 110.78,
      "audio_end_sec": 114.1,
      "text": "The dog is right there-... at her feet."
    },
    {
      "index": 22,
      "segment_id": "seg_0022",
      "speaker_id": "SPEAKER_3",
      "start_sec": 115.02,
      "end_sec": 117.08,
      "duration_sec": 2.06,
      "audio_start_sec": 115.02,
      "audio_end_sec": 117.08,
      "text": "Yeah, but she's not seeing it."
    },
    {
      "index": 23,
      "segment_id": "seg_0023",
      "speaker_id": "SPEAKER_1",
      "start_sec": 117.54,
      "end_sec": 119.54,
      "duration_sec": 2.0,
      "audio_start_sec": 117.54,
      "audio_end_sec": 119.54,
      "text": "All right. Michael, what's your caption?"
    },
    {
      "index": 24,
      "segment_id": "seg_0024",
      "speaker_id": "SPEAKER_4",
      "start_sec": 120.1,
      "end_sec": 120.72,
      "duration_sec": 0.62,
      "audio_start_sec": 120.1,
      "audio_end_sec": 120.72,
      "text": "\"I'm Barbie.\""
    },
    {
      "index": 25,
      "segment_id": "seg_0025",
      "speaker_id": "SPEAKER_1",
      "start_sec": 121.9,
      "end_sec": 124.12,
      "duration_sec": 2.22,
      "audio_start_sec": 121.9,
      "audio_end_sec": 124.12,
      "text": "She's answering the phone saying, \"I'm Barbie\"?"
    },
    {
      "index": 26,
      "segment_id": "seg_0026",
      "speaker_id": "SPEAKER_4",
      "start_sec": 124.82,
      "end_sec": 126.46,
      "duration_sec": 1.64,
      "audio_start_sec": 124.82,
      "audio_end_sec": 126.46,
      "text": "No, she's just thinking it."
    },
    {
      "index": 27,
      "segment_id": "seg_0027",
      "speaker_id": "SPEAKER_2",
      "start_sec": 127.78,
      "end_sec": 132.95,
      "duration_sec": 5.17,
      "audio_start_sec": 127.78,
      "audio_end_sec": 132.95,
      "text": "So she picked up the phone, held it to her face and mouth, and thought, \"I'm Barbie\"?"
    },
    {
      "index": 28,
      "segment_id": "seg_0028",
      "speaker_id": "SPEAKER_4",
      "start_sec": 133.9,
      "end_sec": 135.68,
      "duration_sec": 1.78,
      "audio_start_sec": 133.9,
      "audio_end_sec": 135.68,
      "text": "Yes, exactly. She's practicing."
    },
    {
      "index": 29,
      "segment_id": "seg_0029",
      "speaker_id": "SPEAKER_2",
      "start_sec": 136.42,
      "end_sec": 138.39,
      "duration_sec": 1.97,
      "audio_start_sec": 136.42,
      "audio_end_sec": 138.39,
      "text": "Practicing what? Thinking that she's Barbie?"
    },
    {
      "index": 30,
      "segment_id": "seg_0030",
      "speaker_id": "SPEAKER_1",
      "start_sec": 138.56,
      "end_sec": 140.72,
      "duration_sec": 2.16,
      "audio_start_sec": 138.56,
      "audio_end_sec": 140.72,
      "text": "O- okay, l- let's move on. Jason, your caption?"
    },
    {
      "index": 31,
      "segment_id": "seg_0031",
      "speaker_id": "SPEAKER_5",
      "start_sec": 141.26,
      "end_sec": 149.7,
      "duration_sec": 8.44,
      "audio_start_sec": 141.26,
      "audio_end_sec": 149.7,
      "text": "Hey, I'm so sorry to do this, but I won't be able to come to the party. I just can't. I got all dressed up, but I just can't shake this funk I'm in."
    },
    {
      "index": 32,
      "segment_id": "seg_0032",
      "speaker_id": "SPEAKER_5",
      "start_sec": 151.38,
      "end_sec": 152.2,
      "duration_sec": 0.82,
      "audio_start_sec": 151.38,
      "audio_end_sec": 152.2,
      "text": "I'm freaking out."
    },
    {
      "index": 33,
      "segment_id": "seg_0033",
      "speaker_id": "SPEAKER_5",
      "start_sec": 153.74,
      "end_sec": 156.06,
      "duration_sec": 2.32,
      "audio_start_sec": 153.74,
      "audio_end_sec": 156.06,
      "text": "I'm back to thinking about that girl from four years ago."
    },
    {
      "index": 34,
      "segment_id": "seg_0034",
      "speaker_id": "SPEAKER_5",
      "start_sec": 158.23,
      "end_sec": 165.38,
      "duration_sec": 7.15,
      "audio_start_sec": 158.23,
      "audio_end_sec": 165.38,
      "text": "I know it sounds crazy, but I think she was trying to tell me something. I'm sorry. I'm stuck. Anyway, give me a call when you can."
    },
    {
      "index": 35,
      "segment_id": "seg_0035",
      "speaker_id": "SPEAKER_5",
      "start_sec": 167.56,
      "end_sec": 173.38,
      "duration_sec": 5.82,
      "audio_start_sec": 167.56,
      "audio_end_sec": 173.38,
      "text": "Oh, I'm sorry, this is Barbie. But you knew that, you have caller ID. I'm so stupid. Goodbye."
    },
    {
      "index": 36,
      "segment_id": "seg_0036",
      "speaker_id": "SPEAKER_2",
      "start_sec": 175.74,
      "end_sec": 185.32,
      "duration_sec": 9.58,
      "audio_start_sec": 175.74,
      "audio_end_sec": 185.32,
      "text": "So young man, you are suggesting that not only Barbie will miss a party, but that she's traumatized by something that I just told you never happened to her?"
    },
    {
      "index": 37,
      "segment_id": "seg_0037",
      "speaker_id": "SPEAKER_5",
      "start_sec": 185.94,
      "end_sec": 189.06,
      "duration_sec": 3.12,
      "audio_start_sec": 185.94,
      "audio_end_sec": 189.06,
      "text": "I think addressing the trauma is important. It's a discussion that needs to be had."
    },
    {
      "index": 38,
      "segment_id": "seg_0038",
      "speaker_id": "SPEAKER_2",
      "start_sec": 189.72,
      "end_sec": 192.62,
      "duration_sec": 2.9,
      "audio_start_sec": 189.72,
      "audio_end_sec": 192.62,
      "text": "Not by Barbie. Not by Barbie."
    },
    {
      "index": 39,
      "segment_id": "seg_0039",
      "speaker_id": "SPEAKER_1",
      "start_sec": 192.68,
      "end_sec": 201.44,
      "duration_sec": 8.76,
      "audio_start_sec": 192.68,
      "audio_end_sec": 201.44,
      "text": "Bernard, breathe. Remember your condition. Okay, let's just do another one, but I'll show you what we have in mind, okay? Beautiful sunset in Malibu. You see? Just like that."
    },
    {
      "index": 40,
      "segment_id": "seg_0040",
      "speaker_id": "SPEAKER_4",
      "start_sec": 201.8,
      "end_sec": 201.96,
      "duration_sec": 0.16,
      "audio_start_sec": 201.8,
      "audio_end_sec": 201.96,
      "text": "Oh."
    },
    {
      "index": 41,
      "segment_id": "seg_0041",
      "speaker_id": "SPEAKER_5",
      "start_sec": 202.02,
      "end_sec": 202.68,
      "duration_sec": 0.66,
      "audio_start_sec": 202.02,
      "audio_end_sec": 202.68,
      "text": "Sure, I like it."
    },
    {
      "index": 42,
      "segment_id": "seg_0042",
      "speaker_id": "SPEAKER_1",
      "start_sec": 202.76,
      "end_sec": 203.56,
      "duration_sec": 0.8,
      "audio_start_sec": 202.76,
      "audio_end_sec": 203.56,
      "text": "Okay, go for it."
    },
    {
      "index": 43,
      "segment_id": "seg_0043",
      "speaker_id": "SPEAKER_3",
      "start_sec": 204.82,
      "end_sec": 206.82,
      "duration_sec": 2.0,
      "audio_start_sec": 204.82,
      "audio_end_sec": 206.82,
      "text": "It's almost not night anymore."
    },
    {
      "index": 44,
      "segment_id": "seg_0044",
      "speaker_id": "SPEAKER_1",
      "start_sec": 206.88,
      "end_sec": 207.38,
      "duration_sec": 0.5,
      "audio_start_sec": 206.88,
      "audio_end_sec": 207.38,
      "text": "Oh my God."
    },
    {
      "index": 45,
      "segment_id": "seg_0045",
      "speaker_id": "SPEAKER_1",
      "start_sec": 208.7,
      "end_sec": 209.18,
      "duration_sec": 0.48,
      "audio_start_sec": 208.7,
      "audio_end_sec": 209.18,
      "text": "And you?"
    },
    {
      "index": 46,
      "segment_id": "seg_0046",
      "speaker_id": "SPEAKER_4",
      "start_sec": 210.54,
      "end_sec": 211.24,
      "duration_sec": 0.7,
      "audio_start_sec": 210.54,
      "audio_end_sec": 211.24,
      "text": "Is that Barbie?"
    },
    {
      "index": 47,
      "segment_id": "seg_0047",
      "speaker_id": "SPEAKER_1",
      "start_sec": 212.06,
      "end_sec": 214.16,
      "duration_sec": 2.1,
      "audio_start_sec": 212.06,
      "audio_end_sec": 214.16,
      "text": "Is that Barbie in the picture? Of course that's Barbie."
    },
    {
      "index": 48,
      "segment_id": "seg_0048",
      "speaker_id": "SPEAKER_4",
      "start_sec": 214.54,
      "end_sec": 219.64,
      "duration_sec": 5.1,
      "audio_start_sec": 214.54,
      "audio_end_sec": 219.64,
      "text": "Oh, I didn't recognize her back. In that case, I'm Barbie. This is just my back."
    },
    {
      "index": 49,
      "segment_id": "seg_0049",
      "speaker_id": "SPEAKER_5",
      "start_sec": 221.3,
      "end_sec": 230.92,
      "duration_sec": 9.62,
      "audio_start_sec": 221.3,
      "audio_end_sec": 230.92,
      "text": "Now me. I overheard a woman at the supermarket say the strangest thing. She said, \"There goes Barbie. Poor thing, she doesn't know she's a toy-"
    },
    {
      "index": 50,
      "segment_id": "seg_0050",
      "speaker_id": "SPEAKER_5",
      "start_sec": 232.25,
      "end_sec": 245.76,
      "duration_sec": 13.51,
      "audio_start_sec": 232.25,
      "audio_end_sec": 245.76,
      "text": "... created by a corporation. Silly thing has never wondered where the car or the house came from.\" And the truth is, I'd never thought of those things until today. Today is the first and very last day of my life."
    },
    {
      "index": 51,
      "segment_id": "seg_0051",
      "speaker_id": "SPEAKER_2",
      "start_sec": 248.98,
      "end_sec": 259.82,
      "duration_sec": 10.84,
      "audio_start_sec": 248.98,
      "audio_end_sec": 259.82,
      "text": "Okay, I'm really trying to wrap my brain around this. You're suggesting that Barbie finds out that she's a toy in the supermarket, and then she has some sort of identity crisis that drives her to suicide?"
    },
    {
      "index": 52,
      "segment_id": "seg_0052",
      "speaker_id": "SPEAKER_5",
      "start_sec": 260.2,
      "end_sec": 261.38,
      "duration_sec": 1.18,
      "audio_start_sec": 260.2,
      "audio_end_sec": 261.38,
      "text": "It's the only way she can be free."
    },
    {
      "index": 53,
      "segment_id": "seg_0053",
      "speaker_id": "SPEAKER_2",
      "start_sec": 263.38,
      "end_sec": 268.32,
      "duration_sec": 4.94,
      "audio_start_sec": 263.38,
      "audio_end_sec": 268.32,
      "text": "Okay, Deirdre, I'm gonna close my eyes, and when I open them, I want all three of them out of the building."
    },
    {
      "index": 54,
      "segment_id": "seg_0054",
      "speaker_id": "SPEAKER_1",
      "start_sec": 268.34,
      "end_sec": 273.219,
      "duration_sec": 4.879,
      "audio_start_sec": 268.34,
      "audio_end_sec": 273.219,
      "text": "Yes, yes, and I'm going to leave my eyes open and make sure that that happens for him. Well, leave."
    },
    {
      "index": 55,
      "segment_id": "seg_0055",
      "speaker_id": "SPEAKER_3",
      "start_sec": 273.64,
      "end_sec": 273.75,
      "duration_sec": 0.11,
      "audio_start_sec": 273.64,
      "audio_end_sec": 273.75,
      "text": "Oh."
    },
    {
      "index": 56,
      "segment_id": "seg_0056",
      "speaker_id": "SPEAKER_1",
      "start_sec": 275.94,
      "end_sec": 278.08,
      "duration_sec": 2.14,
      "audio_start_sec": 275.94,
      "audio_end_sec": 278.08,
      "text": "All right, you can open your eyes. They're gone."
    },
    {
      "index": 57,
      "segment_id": "seg_0057",
      "speaker_id": "SPEAKER_2",
      "start_sec": 278.2,
      "end_sec": 278.4,
      "duration_sec": 0.2,
      "audio_start_sec": 278.2,
      "audio_end_sec": 278.4,
      "text": "Thank God."
    },
    {
      "index": 58,
      "segment_id": "seg_0058",
      "speaker_id": "SPEAKER_1",
      "start_sec": 278.46,
      "end_sec": 281.57,
      "duration_sec": 3.11,
      "audio_start_sec": 278.46,
      "audio_end_sec": 281.57,
      "text": "All right, so we're gonna go with the, \"I'm Barbie, this is my back,\" right?"
    },
    {
      "index": 59,
      "segment_id": "seg_0059",
      "speaker_id": "SPEAKER_2",
      "start_sec": 281.72,
